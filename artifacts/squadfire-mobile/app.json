{
  "expo": {
    "name": "SquadFire Mobile",
    "slug": "squadfire-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "squadfire-mobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#08152a",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.feinmach.squadfire",
      "supportsTablet": false
    },
    "android": {
      "package": "com.feinmach.squadfire"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
